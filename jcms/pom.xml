<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ysh</groupId>
    <artifactId>jcms</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>jcms — DL/T 2811 Java Implementation</name>
    <description>Multi-module project: core (JNA binding), utils (SCL, security, config), app (transport, server, client)</description>

    <modules>
        <module>jcms-core</module>
        <module>jcms-utils</module>
        <module>jcms-data</module>
        <module>jcms-app</module>
    </modules>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jcms.version>1.0.0-SNAPSHOT</jcms.version>
        <jna.version>5.14.0</jna.version>
        <junit.version>4.13.2</junit.version>
        <lombok.version>1.18.32</lombok.version>
        <slf4j.version>1.7.36</slf4j.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <bouncycastle.version>1.78</bouncycastle.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ysh</groupId>
                <artifactId>jcms-core</artifactId>
                <version>${jcms.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ysh</groupId>
                <artifactId>jcms-utils</artifactId>
                <version>${jcms.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ysh</groupId>
                <artifactId>jcms-app</artifactId>
                <version>${jcms.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ysh</groupId>
                <artifactId>jcms-data</artifactId>
                <version>${jcms.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <forkCount>0</forkCount>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>2.13.0</version>
                    <configuration>
                        <java>
                            <eclipse>
                                <file>${maven.multiModuleProjectDirectory}/eclipse-formatter.xml</file>
                            </eclipse>
                            <removeUnusedImports/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                            <excludes>
                                <exclude>**/NativeBridge.java</exclude>
                                <exclude>**/info/**</exclude>
                                <exclude>jcms-data/**</exclude>
                            </excludes>
                        </java>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
