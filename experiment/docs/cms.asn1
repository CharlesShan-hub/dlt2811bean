--
-- DL/T 2811 Data Types ? ASN.1 Module
--
-- Generated from Cms* Java classes in com.ysh.dlt2811bean.datatypes
-- All type names correspond to ASN.1 type definitions from GB/T 45906.3.
-- Java prefix "Cms" is stripped for ASN.1 type names.
--

DLT2811-DataTypes { 1 2 156 2811 1 } DEFINITIONS AUTOMATIC TAGS ::= BEGIN

-- ======================================================================
-- 7.1.1 BOOLEAN
-- ======================================================================

-- PER encoding: constrained integer (0..1), 1 bit
Boolean ::= INTEGER (0..1)

-- ======================================================================
-- 7.1.2 Integer Types
-- ======================================================================

-- PER encoding: constrained integer, 8 bits aligned
Int8  ::= INTEGER (-128..127)

-- PER encoding: constrained integer, 8 bits aligned
Int8U ::= INTEGER (0..255)

-- PER encoding: constrained integer, 16 bits aligned
Int16 ::= INTEGER (-32768..32767)

-- PER encoding: constrained integer, 16 bits aligned
Int16U ::= INTEGER (0..65535)

-- PER encoding: constrained integer, 24 bits aligned
Int24U ::= INTEGER (0..16777215)

-- PER encoding: constrained integer, 32 bits aligned
Int32  ::= INTEGER (-2147483648..2147483647)

-- PER encoding: constrained integer, 32 bits aligned
Int32U ::= INTEGER (0..4294967295)

-- PER encoding: length determinant + content bytes
Int64  ::= INTEGER (-9223372036854775808..9223372036854775807)

-- PER encoding: length determinant + content bytes
Int64U ::= INTEGER (0..18446744073709551615)

-- ======================================================================
-- 7.1.4 Floating-Point Types
-- ======================================================================

Float32 ::= OCTET STRING (SIZE (4))

Float64 ::= OCTET STRING (SIZE (8))

-- ======================================================================
-- 7.1.5 String Types
-- ======================================================================

-- PER encoding: length prefix + 8-bit characters
VisibleString ::= VisibleString (SIZE(0..255))

-- PER encoding: length prefix + UTF-8 bytes
UTF8String ::= UTF8String (SIZE(0..255))

-- PER encoding: length prefix + raw bytes
OctetString ::= OCTET STRING (SIZE(0..65535))

BitString ::= BIT STRING (SIZE(0..65535))

-- ======================================================================
-- 7.1.6 ENUMERATED
-- ======================================================================

-- ======================================================================
-- 7.1.7 CODED ENUM
-- ======================================================================

-- ======================================================================
-- 7.1.8 Packed List
-- ======================================================================

PackedList ::= BIT STRING (SIZE(0..65535))

-- ======================================================================
-- 7.2.1 UtcTime
-- ======================================================================

UtcTime ::= OCTET STRING (SIZE(8))

TimeQuality ::= BIT STRING {
    leap-second-known            (0),
    clock-failure                (1),
    clock-not-synchronized       (2)
} (SIZE(3))

-- ======================================================================
-- 7.2.2 BinaryTime / EntryTime
-- ======================================================================

BinaryTime ::= SEQUENCE {
    msOfDay       Int32U,          -- milliseconds since midnight (0..86399999)
    daysSince1984 Int16U           -- days since 1984-01-01
}

EntryTime ::= BinaryTime

-- ======================================================================
-- 7.3.1 ObjectName
-- ======================================================================

-- PER encoding: VisibleString with max length 64
ObjectName ::= VisibleString (SIZE(0..64))

-- ======================================================================
-- 7.3.2 ObjectReference
-- ======================================================================

-- Format: LDName/LNName[.Name[....]]
-- PER encoding: VisibleString with max length 129
ObjectReference ::= VisibleString (SIZE(0..129))

-- ======================================================================
-- 7.3.3 SubReference
-- ======================================================================

SubReference ::= VisibleString (SIZE(0..129))

-- ======================================================================
-- 7.3.4 TimeStamp
-- ======================================================================

TimeStamp ::= SEQUENCE {
    secondsSinceEpoch Int32,
    fractional        Int24U
}

-- ======================================================================
-- 7.3.5 Dbpos
-- ======================================================================

Dbpos ::= ENUMERATED { intermediate(0), off(1), on(2), badState(3) }

-- ======================================================================
-- 7.3.6 Quality
-- ======================================================================

Quality ::= BIT STRING (SIZE(13))

-- ======================================================================
-- 7.3.7 Tcmd
-- ======================================================================

Tcmd ::= ENUMERATED { reserved(0), select(1), operate(2), cancel(3) }

-- ======================================================================
-- 7.3.8 EntryID
-- ======================================================================

EntryID ::= OCTET STRING (SIZE(8))

-- ======================================================================
-- 7.3.9 EntryTime
-- ======================================================================

EntryTime ::= BinaryTime

-- ======================================================================
-- 7.3.10 FileEntry
-- ======================================================================

FileEntry ::= SEQUENCE {
    fileName    VisibleString (SIZE(0..255)),
    fileSize    Int32U,
    lastModified UtcTime OPTIONAL,
    fileType    VisibleString (SIZE(0..64)) OPTIONAL,
    fileAttr    VisibleString (SIZE(0..64)) OPTIONAL
}

-- ======================================================================
-- 7.3.11 ServiceError
-- ======================================================================

ServiceError ::= INTEGER {
    no-error                                      (0),
    instance-not-available                        (1),
    instance-in-use                               (2),
    access-violation                              (3),
    access-not-allowed-in-current-state            (4),
    parameter-value-inappropriate                 (5),
    parameter-value-inconsistent                  (6),
    class-not-supported                           (7),
    instance-locked-by-other-client               (8),
    control-must-be-selected                      (9),
    type-conflict                                 (10),
    failed-due-to-communications-constraint       (11),
    failed-due-to-server-constraint               (12)
} (0..12)

-- ======================================================================
-- 7.3.12 PhyComAddr
-- ======================================================================

PhyComAddr ::= SEQUENCE {
    addr        [0] IMPLICIT OCTET STRING (SIZE(6)),
    priority    [1] IMPLICIT Int8U,
    vid         [2] IMPLICIT Int16U,
    appid       [3] IMPLICIT Int16U
}

-- ======================================================================
-- 7.4 FC
-- ======================================================================

FC ::= BIT STRING (SIZE(16))


-- ======================================================================
-- 7.5.1 Control Blocks Attributes
-- ======================================================================

-- ======================================================================
-- 7.5.2 Originator
-- ======================================================================

Originator ::= SEQUENCE {
    orCat        [0] IMPLICIT INTEGER {
        notSupported      (0),
        bayControl        (1),
        stationControl    (2),
        remoteControl     (3),
        automaticBay      (4),
        automaticStation  (5),
        automaticRemote   (6),
        maintenance       (7),
        process           (8)
    } (0..8),
    orIdent      [1] IMPLICIT OCTET STRING (SIZE(0..64))
}

-- ======================================================================
-- 7.5.3 Check
-- ======================================================================

Check ::= BIT STRING (SIZE(16))

-- ======================================================================
-- 7.5.4 AddCause
-- ======================================================================

AddCause ::= ENUMERATED {
    unknown                    (0),
    processError               (1),
    protocolError              (2),
    applicationError           (3),
    performanceLimitation      (4),
    resourceLimitation         (5),
    authenticationFailure      (6),
    securityViolation          (7),
    communicationFailure       (8),
    systemFailure              (9),
    hardwareFailure            (10),
    softwareFailure            (11),
    configurationError         (12),
    operationNotSupported      (13),
    operationBlocked           (14),
    temporaryFailure           (15),
    permanentFailure           (16)
}

-- ======================================================================
-- 7.6.1 Control Blocks
-- ======================================================================

SGCB ::= SEQUENCE {
    sgcbName ObjectName,
    sgcbRef  ObjectReference,
    numOfSG  Int8U,
    actSG    Int8U,
    editSG   Int8U,
    cnfEdit  BOOLEAN,
    lActTm   UtcTime,
    resvTms  Int16U OPTIONAL
}

BRCB ::= SEQUENCE {
    brcbName    ObjectName,
    brcbRef     ObjectReference,
    rptID       VisibleString (SIZE(0..129)),
    rptEna      BOOLEAN,
    datSet      ObjectReference,
    confRev     Int32U,
    optFlds     RcbOptFlds,
    bufTm       Int32U,
    sqNum       Int16U,
    trgOps      TriggerConditions,
    intgPd      Int32U,
    gi          BOOLEAN,
    purgeBuf    BOOLEAN,
    entryID     EntryID,
    timeOfEntry EntryTime,
    resvTms     Int16 OPTIONAL,
    owner       OCTET STRING (SIZE(64))
}

URCB ::= SEQUENCE {
    urcbName ObjectName,
    urcbRef  ObjectReference,
    rptID    VisibleString (SIZE(0..129)),
    rptEna   BOOLEAN,
    resv     BOOLEAN,
    datSet   ObjectReference,
    confRev  Int32U,
    optFlds  RcbOptFlds,
    bufTm    Int32U,
    sqNum    Int8U,
    trgOps   TriggerConditions,
    intgPd   Int32U,
    gi       BOOLEAN,
    owner    OCTET STRING (SIZE(64))
}

LCB ::= SEQUENCE {
    lcbName ObjectName,
    lcbRef  ObjectReference,
    rptID   VisibleString (SIZE(0..129)),
    logEna  BOOLEAN,
    datSet  ObjectReference,
    confRev Int32U,
    optFlds LcbOptFlds,
    bufTm   Int32U,
    trgOps  TriggerConditions,
    intgPd  Int32U,
    logRef  ObjectReference
}

GoCB ::= SEQUENCE {
    gocbRef       ObjectReference,
    appID         VisibleString (SIZE(0..129)),
    datSet        ObjectReference,
    confRev       Int32U,
    ndcom         BOOLEAN,
    dstAddress    PhyComAddr,
    minTime       Int32U,
    maxTime       Int32U,
    fixedOffs     BOOLEAN,
    goID          VisibleString (SIZE(0..129)) OPTIONAL
}

MSVCB ::= SEQUENCE {
    msvcbRef       ObjectReference,
    svID           VisibleString (SIZE(0..129)),
    datSet         ObjectReference,
    confRev        Int32U,
    smpRate        Int32U,
    nofASDU        Int8U,
    optFlds        MsvcbOptFlds,
    smpMod         SmpMod,
    dstAddress     PhyComAddr,
    svEna          BOOLEAN,
    reserved1      BOOLEAN,
    svCbHealth     VisibleString (SIZE(0..129)) OPTIONAL,
    svCbAlarmName  VisibleString (SIZE(0..129)) OPTIONAL
}

-- ======================================================================
-- 7.6.2 TriggerConditions
-- ======================================================================

TriggerConditions ::= BIT STRING {
    reserved                    (0),
    data-change                 (1),
    quality-change              (2),
    data-update                 (3),
    integrity                   (4),
    general-interrogation       (5)
} (SIZE(6))

-- ======================================================================
-- 7.6.3 ReasonCode
-- ======================================================================

ReasonCode ::= BIT STRING {
    reserved                    (0),
    data-change                 (1),
    quality-change              (2),
    data-update                 (3),
    integrity                   (4),
    general-interrogation       (5),
    application-trigger         (6)
} (SIZE(7))

-- ======================================================================
-- 7.6.4 RcbOptFlds
-- ======================================================================

RcbOptFlds ::= BIT STRING {
    reserved                    (0),
    sequence-number             (1),
    report-time-stamp           (2),
    reason-for-inclusion        (3),
    data-set-name               (4),
    data-reference              (5),
    buffer-overflow             (6),
    entryID                     (7),
    conf-revision               (8),
    segmentation                (9)
} (SIZE(10))

-- ======================================================================
-- 7.6.5 LcbOptFlds
-- ======================================================================

LcbOptFlds ::= BIT STRING (SIZE(1))

-- ======================================================================
-- 7.6.6 MsvcbOptFlds
-- ======================================================================

MsvcbOptFlds ::= BIT STRING {
    refresh-time                (0),
    reserved                    (1),
    sample-rate                 (2),
    data-set-name               (3),
    security                    (4)
} (SIZE(5))

-- ======================================================================
-- 7.6.7 SmpMod
-- ======================================================================

SmpMod ::= INTEGER {
    samples-per-nominal-period    (0),
    samples-per-second            (1),
    seconds-per-sample            (2)
} (0..2)

-- ======================================================================
-- 7.7 Data (CHOICE of 24 alternatives)
-- ======================================================================

Data ::= CHOICE {
    error              [0] IMPLICIT ServiceError,
    array              [1] IMPLICIT SEQUENCE OF Data,
    structure          [2] IMPLICIT SEQUENCE OF Data,
    boolean            [3] IMPLICIT BOOLEAN,
    int8               [4] IMPLICIT Int8,
    int16              [5] IMPLICIT Int16,
    int32              [6] IMPLICIT Int32,
    int64              [7] IMPLICIT Int64,
    int8u              [8] IMPLICIT Int8U,
    int16u             [9] IMPLICIT Int16U,
    int32u             [10] IMPLICIT Int32U,
    int64u             [11] IMPLICIT Int64U,
    float32            [12] IMPLICIT Float32,
    float64            [13] IMPLICIT Float64,
    bit-string         [14] IMPLICIT BIT STRING,
    octet-string       [15] IMPLICIT OCTET STRING,
    visible-string     [16] IMPLICIT VisibleString,
    unicode-string     [17] IMPLICIT UTF8String,
    utc-time           [18] IMPLICIT UtcTime,
    binary-time        [19] IMPLICIT BinaryTime,
    quality            [20] IMPLICIT Quality,
    dbpos              [21] IMPLICIT Dbpos,
    tcmd               [22] IMPLICIT Tcmd,
    check              [23] IMPLICIT Check
}

-- ======================================================================
-- 7.8 DataDefinition
-- ======================================================================

DataDefinition ::= CHOICE {
    error              [0] IMPLICIT ServiceError,
    array              [1] IMPLICIT SEQUENCE {
        numberOfElement  [1] IMPLICIT Int32,
        elementType      [2] DataDefinition
    },
    structure          [2] IMPLICIT SEQUENCE OF SEQUENCE {
        name             [0] IMPLICIT ObjectName,
        fc               [1] IMPLICIT FunctionalConstraint OPTIONAL,
        type             [2] DataDefinition
    },
    boolean            [3] IMPLICIT NULL,
    int8               [4] IMPLICIT NULL,
    int16              [5] IMPLICIT NULL,
    int32              [6] IMPLICIT NULL,
    int64              [7] IMPLICIT NULL,
    int8u              [8] IMPLICIT NULL,
    int16u             [9] IMPLICIT NULL,
    int32u             [10] IMPLICIT NULL,
    int64u             [11] IMPLICIT NULL,
    float32            [12] IMPLICIT NULL,
    float64            [13] IMPLICIT NULL,
    bit-string         [14] IMPLICIT INTEGER,
    octet-string       [15] IMPLICIT INTEGER,
    visible-string     [16] IMPLICIT INTEGER,
    unicode-string     [17] IMPLICIT INTEGER,
    utc-time           [18] IMPLICIT NULL,
    binary-time        [19] IMPLICIT NULL,
    quality            [20] IMPLICIT NULL,
    dbpos              [21] IMPLICIT NULL,
    tcmd               [22] IMPLICIT NULL,
    check              [23] IMPLICIT NULL
}






--
-- DL/T 2811 Protocol Layer ? APCH / ASDU definitions
--
-- This is the foundation layer for all services.
--

-- ======================================================================
-- APCH ? Application Protocol Control Header (4 bytes)
-- ======================================================================

Apch ::= SEQUENCE {
    cc          ControlCode,
    sc          Int8U,
    fl          Int16U
}

ControlCode ::= SEQUENCE {
    next        BOOLEAN,
    resp        BOOLEAN,
    err         BOOLEAN,
    pi          Int8U
}

-- ======================================================================
-- ASDU ? Application Service Data Unit (base for all services)
-- ======================================================================

-- reqId is the first field in every ASDU
Asdu ::= SEQUENCE {
    reqId       Int16U
}

-- ======================================================================
-- APDU ? Complete application-layer frame
-- ======================================================================

Apdu ::= SEQUENCE {
    apch        Apch,
    asdu        OCTET STRING (SIZE(0..65531))
}

--
-- DL/T 2811 Association Services ? Associate / Release / Abort
--

-- ======================================================================
-- 8.2.1 Associate (Service Code 0x01)
-- ======================================================================

-- Request: serverAccessPointReference + authenticationParameter
-- Response+: associationId + serviceError + authenticationParameter
-- Response-: serviceError

AuthenticationParameter ::= SEQUENCE {
    signatureCertificate    OCTET STRING (SIZE(0..65535)),
    signedTime              UtcTime,
    signedValue             OCTET STRING (SIZE(0..65535))
}

ServerAccessPointReference ::= VisibleString (SIZE(0..129))

Associate-Request ::= SEQUENCE {
    reqId                       Int16U,
    serverAccessPointReference  ServerAccessPointReference,
    authenticationParameter     AuthenticationParameter OPTIONAL
}

Associate-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    associationId               OCTET STRING (SIZE(64)),
    serviceError                ServiceError,
    authenticationParameter     AuthenticationParameter OPTIONAL
}

Associate-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.2.2 Release (Service Code 0x02)
-- ======================================================================

-- Request: no additional fields beyond reqId
-- Response+: releaseResponse
-- Response-: serviceError

Release-Request ::= SEQUENCE {
    reqId                       Int16U
}

Release-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    releaseResponse             BOOLEAN
}

Release-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.2.3 Abort (Service Code 0x03)
-- ======================================================================

-- No request/response ? unidirectional

Abort ::= SEQUENCE {
    reqId                       Int16U,
    abortReason                 AbortReason
}

AbortReason ::= ENUMERATED {
    noReason                    (0),
    unrecognizedAPDU            (1),
    unexpectedAPDU              (2),
    unexpectedSession           (3),
    protocolError               (4),
    authenticationError         (5),
    userRequest                 (6),
    resourceLimit               (7),
    internalError               (8)
}

-- ======================================================================
-- 8.2.4 AssociateNegotiate (Service Code 0x04)
-- ======================================================================


NegotiationParameter ::= SEQUENCE {
    maxReqIdSize                Int16U,
    maxSegmentSize              Int32U,
    supportedServices           OCTET STRING (SIZE(0..65535)),
    protocolVersion             VisibleString (SIZE(0..32))
}

AssociateNegotiate-Request ::= SEQUENCE {
    reqId                       Int16U,
    negotiationParameters       NegotiationParameter
}

AssociateNegotiate-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    negotiationParameters       NegotiationParameter
}

AssociateNegotiate-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

--
-- DL/T 2811 Data Services ? GetDataSetValues / SetDataSetValues / GetDataDefinition / GetDataDirectory
--

-- ======================================================================
-- 8.3.1 GetDataSetValues (Service Code 0x11)
-- ======================================================================

-- Request: ObjectReference
-- Response+: Data[]
-- Response-: ServiceError

GetDataValues-Entry ::= SEQUENCE {
    dataRef                     ObjectReference,
    data                        Data
}

GetDataValues-Request ::= SEQUENCE {
    reqId                       Int16U,
    dataRefs                    SEQUENCE OF ObjectReference
}

GetDataValues-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    values                      SEQUENCE OF GetDataValues-Entry
}

GetDataValues-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.3.2 SetDataSetValues (Service Code 0x12)
-- ======================================================================


SetDataValues-Entry ::= SEQUENCE {
    dataRef                     ObjectReference,
    data                        Data
}

SetDataValues-Request ::= SEQUENCE {
    reqId                       Int16U,
    values                      SEQUENCE OF SetDataValues-Entry
}

SetDataValues-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U
}

SetDataValues-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.3.3 GetDataDefinition (Service Code 0x13)
-- ======================================================================


GetDataDefinition-Entry ::= SEQUENCE {
    dataRef                     ObjectReference,
    dataDefinition              DataDefinition
}

GetDataDefinition-Request ::= SEQUENCE {
    reqId                       Int16U,
    dataRef                     ObjectReference
}

GetDataDefinition-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    definition                  GetDataDefinition-Entry
}

GetDataDefinition-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.3.4 GetDataDirectory (Service Code 0x14)
-- ======================================================================


GetDataDirectory-Entry ::= SEQUENCE {
    dataRef                     ObjectReference,
    fc                          FC
}

GetDataDirectory-Request ::= SEQUENCE {
    reqId                       Int16U,
    dataRef                     ObjectReference
}

GetDataDirectory-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    entries                     SEQUENCE OF GetDataDirectory-Entry
}

GetDataDirectory-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

--
-- DL/T 2811 Control Services ? Select / Operate / Cancel / CommandTermination
--

-- ======================================================================
-- 8.4.1 Select (Service Code 0x21)
-- ======================================================================


Select-Request ::= SEQUENCE {
    reqId                       Int16U,
    actCode                     Tcmd,
    actRef                      ObjectReference,
    actData                     Data OPTIONAL
}

Select-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    actCnf                      Check
}

Select-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.4.2 SelectWithValue (Service Code 0x22)
-- ======================================================================


SelectWithValue-Request ::= SEQUENCE {
    reqId                       Int16U,
    actCode                     Tcmd,
    actRef                      ObjectReference,
    actData                     Data
}

SelectWithValue-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    actCnf                      Check
}

SelectWithValue-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.4.3 Operate (Service Code 0x23)
-- ======================================================================


Operate-Request ::= SEQUENCE {
    reqId                       Int16U,
    actCode                     Tcmd,
    actRef                      ObjectReference,
    actData                     OPTIONAL,
    orCat                       OrCat,
    orIdent                     OctetString (SIZE(0..64))
}

Operate-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    actCnf                      Check
}

Operate-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.4.4 Cancel (Service Code 0x24)
-- ======================================================================


Cancel-Request ::= SEQUENCE {
    reqId                       Int16U,
    actRef                      ObjectReference,
    actCode                     Tcmd
}

Cancel-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    actCnf                      Check
}

Cancel-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.4.5 TimeActivatedOperate (Service Code 0x25)
-- ======================================================================


TimeActivatedOperate-Request ::= SEQUENCE {
    reqId                       Int16U,
    actCode                     Tcmd,
    actRef                      ObjectReference,
    actData                     Data OPTIONAL,
    orCat                       OrCat,
    orIdent                     OctetString (SIZE(0..64)),
    tActTm                      UtcTime
}

TimeActivatedOperate-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    actCnf                      Check
}

TimeActivatedOperate-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.4.6 CommandTermination (Service Code 0x26)
-- ======================================================================

-- Unconfirmed service (server ? client)

CommandTermination ::= SEQUENCE {
    reqId                       Int16U,
    actRef                      ObjectReference,
    actCnf                      Check,
    actData                     Data OPTIONAL
}

-- ======================================================================
-- 8.4.7 TimeActivatedOperateTermination (Service Code 0x27)
-- ======================================================================

-- Unconfirmed service (server ? client)

TimeActivatedOperateTermination ::= SEQUENCE {
    reqId                       Int16U,
    actRef                      ObjectReference,
    actCnf                      Check,
    tActTm                      UtcTime,
    actData                     Data OPTIONAL
}

--
-- DL/T 2811 Report Services ? BRCB / URCB / Report
--

-- ======================================================================
-- 8.5.1 GetBRCBValues (Service Code 0x31)
-- ======================================================================


GetBRCBValues-Request ::= SEQUENCE {
    reqId                       Int16U,
    brcbRef                     ObjectReference
}

GetBRCBValues-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    brcbName                    ObjectReference,
    rptID                       VisibleString (SIZE(0..129)),
    rptEna                      BOOLEAN,
    datSet                      ObjectReference,
    confRev                     Int32U,
    optFlds                     RcbOptFlds,
    bufTm                       Int32U,
    sqNum                       Int16U,
    trgOps                      TriggerConditions,
    intgPd                      Int32U,
    gi                          BOOLEAN,
    purgeBuf                    BOOLEAN,
    entryID                     EntryID,
    timeOfEntry                 EntryTime,
    owner                       OCTET STRING (SIZE(64))
}

GetBRCBValues-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.5.2 SetBRCBValues (Service Code 0x32)
-- ======================================================================


SetBRCBValues-Entry ::= SEQUENCE {
    reference                   ObjectReference,
    rptEna                      BOOLEAN OPTIONAL,
    rptID                       VisibleString (SIZE(0..129)) OPTIONAL,
    datSet                      ObjectReference OPTIONAL,
    confRev                     Int32U OPTIONAL,
    optFlds                     RcbOptFlds OPTIONAL,
    bufTm                       Int32U OPTIONAL,
    trgOps                      TriggerConditions OPTIONAL,
    intgPd                      Int32U OPTIONAL,
    gi                          BOOLEAN OPTIONAL,
    purgeBuf                    BOOLEAN OPTIONAL,
    entryID                     EntryID OPTIONAL,
    timeOfEntry                 EntryTime OPTIONAL,
    reserved                    BOOLEAN OPTIONAL
}

SetBRCBValues-Request ::= SEQUENCE {
    reqId                       Int16U,
    brcbValues                  SEQUENCE OF SetBRCBValues-Entry
}

SetBRCBValues-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U
}

SetBRCBValues-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.5.3 GetURCBValues (Service Code 0x33)
-- ======================================================================


