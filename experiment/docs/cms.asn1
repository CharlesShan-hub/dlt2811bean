    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.11.4 GetRpcMethodDefinition (Service Code 0x94)
-- ======================================================================


RpcMethodValue ::= SEQUENCE {
    paramName                   VisibleString (SIZE(0..64)),
    paramType                   VisibleString (SIZE(0..32)),
    paramValue                  Data OPTIONAL
}

GetRpcMethodDefinition-Request ::= SEQUENCE {
    reqId                       Int16U,
    interfaceName               VisibleString (SIZE(0..64)),
    methodName                  VisibleString (SIZE(0..64))
}

GetRpcMethodDefinition-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    interfaceName               VisibleString (SIZE(0..64)),
    methodName                  VisibleString (SIZE(0..64)),
    parameters                  SEQUENCE OF RpcMethodValue
}

GetRpcMethodDefinition-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.11.5 RpcCall (Service Code 0x95)
-- ======================================================================


RpcCall-Request ::= SEQUENCE {
    reqId                       Int16U,
    interfaceName               VisibleString (SIZE(0..64)),
    methodName                  VisibleString (SIZE(0..64)),
    parameters                  SEQUENCE OF RpcMethodValue
}

RpcCall-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    responseValues              SEQUENCE OF RpcMethodValue
}

RpcCall-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

-- ======================================================================
-- 8.12.1 Test (Service Code 0xA1)
-- ======================================================================

Test-Request ::= SEQUENCE {
    reqId                       Int16U
}

Test-ResponsePositive ::= SEQUENCE {
    reqId                       Int16U,
    testResult                  BOOLEAN
}

Test-ResponseNegative ::= SEQUENCE {
    reqId                       Int16U,
    serviceError                ServiceError
}

END
