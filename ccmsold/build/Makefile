# target to preprocess a source file
src/svc/other/cms_svc_util.c.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\ccms.dir\build.make CMakeFiles/ccms.dir/src/svc/other/cms_svc_util.c.i
.PHONY : src/svc/other/cms_svc_util.c.i

src/svc/other/cms_svc_util.s: src/svc/other/cms_svc_util.c.s
.PHONY : src/svc/other/cms_svc_util.s

# target to generate assembly for a file
src/svc/other/cms_svc_util.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\ccms.dir\build.make CMakeFiles/ccms.dir/src/svc/other/cms_svc_util.c.s
.PHONY : src/svc/other/cms_svc_util.c.s

